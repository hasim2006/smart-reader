# =================================================================
# Track Report Enterprise - Environment Configuration Template
# =================================================================

# -----------------------------------------------------------------
# 1. Official WhatsApp Business API (Meta Cloud API - Primary)
# -----------------------------------------------------------------
# Generate system token in Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_CLOUD_API_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=109283019283109
WHATSAPP_TEMPLATE_NAME=verification_code

# -----------------------------------------------------------------
# 2. Twilio WhatsApp API (Alternative / Fallback Provider)
# -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=0a...
TWILIO_WHATSAPP_NUMBER=+14155238886

# -----------------------------------------------------------------
# 3. SMTP Email Gateway Configuration (Nodemailer / Gmail / SendGrid / AWS SES)
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Track Report Enterprise Security" <auth@trackreport.ai>

# -----------------------------------------------------------------
# 4. Environment & Development Fallback Flags
# -----------------------------------------------------------------
NODE_ENV=development
ENABLE_DEV_OTP_FALLBACK=true
